{
  "name": "monmate",
  "private": true,
  "version": "0.1.0",
  "description": "MonMate activity check-in platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @monmate/web dev",
    "build": "yarn workspace @monmate/web build",
    "typecheck": "yarn workspace @monmate/web typecheck",
    "lint": "yarn workspace @monmate/web lint"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.0 <2"
  },
  "resolutions": {
    "postcss": "^8.5.10"
  }
}
